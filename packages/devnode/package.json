{
	"name": "@webevm/devnode",
	"version": "0.0.0",
	"description": "Dev accounts for webevm: a SlimNode decorator that answers eth_accounts with anvil's / Hardhat's test accounts, funded at genesis, and forwards everything else to the node.",
	"keywords": [
		"ethereum",
		"eip-1193",
		"webevm",
		"dev-node",
		"anvil",
		"hardhat",
		"local-chain",
		"in-browser"
	],
	"license": "MIT",
	"author": "wighawag",
	"homepage": "https://github.com/wighawag/webevm/tree/main/packages/devnode#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/webevm.git",
		"directory": "packages/devnode"
	},
	"bugs": {
		"url": "https://github.com/wighawag/webevm/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./worker-host": {
			"types": "./dist/worker-host.d.ts",
			"default": "./dist/worker-host.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@eip-1193/over-port": "^0.2.0",
		"@ethereumjs/common": "^10.1.2",
		"@ethereumjs/tx": "^10.1.2",
		"@ethereumjs/util": "^10.1.2",
		"@noble/curves": "^2.2.0",
		"@noble/hashes": "^2.2.0",
		"@scure/bip32": "^2.0.0",
		"@scure/bip39": "^2.0.0"
	},
	"peerDependencies": {
		"comlink": "^4.4.2",
		"webevm": ">=0.10.0"
	},
	"peerDependenciesMeta": {
		"comlink": {
			"optional": true
		}
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/node": "^25.2.0",
		"as-soon": "^0.1.5",
		"buffer": "^6.0.3",
		"esbuild": "^0.28.0",
		"playwright-browser-harness": "^0.3.0",
		"prettier": "^3.8.0",
		"typescript": "^5.3.3",
		"viem": "^2.45.0",
		"webevm": "workspace:*"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build": "tsc -p tsconfig.build.json",
		"dev": "as-soon -w src pnpm build",
		"test": "playwright test",
		"prepack": "cp ../../LICENSE ./LICENSE"
	}
}
