{
	"name": "webevm",
	"version": "0.6.0",
	"description": "Slim, execution-only in-browser EIP-1193 Ethereum node on @ethereumjs/vm. Transport-agnostic core + optional comlink Worker helpers + IndexedDB persistence.",
	"keywords": [
		"ethereum",
		"eip-1193",
		"ethereumjs",
		"evm",
		"in-browser",
		"node",
		"local-chain",
		"viem"
	],
	"license": "MIT",
	"author": "wighawag",
	"homepage": "https://github.com/wighawag/webevm#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/webevm.git",
		"directory": "packages/webevm"
	},
	"bugs": {
		"url": "https://github.com/wighawag/webevm/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./revm": {
			"types": "./dist/revm.d.ts",
			"default": "./dist/revm.js"
		},
		"./worker-entry": {
			"types": "./dist/worker-entry.d.ts",
			"default": "./dist/worker-entry.js"
		},
		"./worker-host": {
			"types": "./dist/worker-host.d.ts",
			"default": "./dist/worker-host.js"
		},
		"./worker-client": {
			"types": "./dist/worker-client.d.ts",
			"default": "./dist/worker-client.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@ethereumjs/block": "^10.1.2",
		"@ethereumjs/common": "^10.1.2",
		"@ethereumjs/evm": "^10.1.2",
		"@ethereumjs/statemanager": "^10.1.2",
		"@ethereumjs/tx": "^10.1.2",
		"@ethereumjs/util": "^10.1.2",
		"@ethereumjs/vm": "^10.1.2",
		"@noble/hashes": "^2.2.0",
		"revm-wasm": "^0.3.1"
	},
	"peerDependencies": {
		"comlink": "^4.4.2"
	},
	"peerDependenciesMeta": {
		"comlink": {
			"optional": true
		}
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/node": "^25.2.0",
		"as-soon": "^0.1.5",
		"buffer": "^6.0.3",
		"comlink": "^4.4.2",
		"esbuild": "^0.28.0",
		"playwright-browser-harness": "^0.3.0",
		"prettier": "^3.8.0",
		"tsx": "^4.21.0",
		"typescript": "^5.3.3",
		"viem": "^2.45.0"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build": "tsc -p tsconfig.build.json",
		"dev": "as-soon -w src pnpm build",
		"test": "playwright test",
		"prepack": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE"
	}
}
